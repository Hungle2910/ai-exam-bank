{
    auto_https disable_redirects
}

# Replace the hostname and app IP after deployment. Never serve this example as-is.
staging.example.com {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    handle /api/* {
        reverse_proxy 10.20.11.10:8080
    }
    handle /admin/infrastructure {
        reverse_proxy 10.20.11.10:8080
    }
    handle /infrastructure-panel.* {
        reverse_proxy 10.20.11.10:8080
    }
    handle {
        root * /opt/aieb/web/current
        try_files {path} /index.html
        file_server
    }
}
